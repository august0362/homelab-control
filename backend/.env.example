# Copy to backend/.env and adjust. Never commit the real .env file.

# Bind address. Keep 127.0.0.1: remote access goes through Tailscale Serve,
# never through a public port.
HOST=127.0.0.1
PORT=8000

# Device identity (SPEC §4). DEVICE_ID empty = UUID generated once in STATE_DIR.
DEVICE_ID=
# Shown as "Monitoring <label>". Empty = hostname. E.g. "this ASUS" or "Dell".
DEVICE_LABEL=this ASUS
# dev | production
MACHINE_ROLE=dev

# Built frontend served on the same origin (production). Relative paths are
# resolved from backend/. Ignored if the folder has no index.html.
FRONTEND_DIST=../frontend/dist
STATE_DIR=.state

LOG_LEVEL=info

# Owner login (D-23). Leave empty here: set it with scripts\set-password.ps1,
# which writes only a scrypt hash. Empty = nobody can sign in.
OWNER_PASSWORD_HASH=
# Extra origins allowed to send writes (comma-separated), e.g. the Tailscale
# Serve URL in M6: https://dell.your-tailnet.ts.net. Same-host requests always pass.
ALLOWED_ORIGINS=
